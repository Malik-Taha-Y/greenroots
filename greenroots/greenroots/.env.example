# Get a free key from Google AI Studio: https://aistudio.google.com/api-keys
# Gemini has a genuine free tier (rate-limited requests per minute/day) — no card required
# to start, unlike Anthropic/OpenAI's API which is pay-per-token from the start.
GEMINI_API_KEY=AIza...

# Optional — defaults to gemini-2.5-flash if not set (fast, and covered by the free tier).
GEMINI_MODEL=gemini-2.5-flash
